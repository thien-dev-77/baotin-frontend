{
  "name": "bao-tin-b2b",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "catalog:template": "node scripts/generate-catalog-template.mjs",
    "test:catalog-template": "node --test tests/catalog-template.test.mjs",
    "test:domain": "playwright test tests/domain.spec.ts tests/product-pricing.spec.ts tests/commerce-api.spec.ts tests/backend-proxy.spec.ts tests/auth-state.spec.ts tests/public-cache.spec.ts tests/admin-resources.spec.ts --workers=1",
    "test:pricing": "playwright test tests/product-pricing.spec.ts tests/product-pricing-ui.spec.ts --workers=1",
    "test:materials": "node --import tsx --test tests/material-groups.test.ts && playwright test tests/material-filter-ui.spec.ts --workers=1",
    "test:product-filters": "node --import tsx --test tests/material-groups.test.ts tests/product-filter-attributes.test.ts && playwright test tests/material-filter-ui.spec.ts tests/product-editor-content-ui.spec.ts --grep 'Facet selections|Empty manual facets|new color variant|material|exact material|Desktop groups|Color and origin groups|A category without colors|Product skeletons' --workers=1",
    "test:variants": "node --import tsx --test tests/product-variant-labels.test.ts && playwright test tests/product-variants.spec.ts --workers=1",
    "test:variant-types": "playwright test tests/product-variant-group-ui.spec.ts tests/product-variant-detach-ui.spec.ts --workers=1",
    "test:variant-attach": "playwright test tests/product-variant-attach-ui.spec.ts --workers=1",
    "test:product-guides": "node --import tsx --test tests/product-guide-links.test.ts && playwright test tests/product-editor-content-ui.spec.ts --grep 'Usage guide links' --workers=1",
    "test:product-optimizations": "playwright test tests/backend-proxy.spec.ts tests/admin-resources.spec.ts tests/product-editor-content-ui.spec.ts tests/product-variant-attach-ui.spec.ts --workers=1",
    "test:auth": "playwright test tests/auth-ui.spec.ts --workers=1",
    "test:experience": "playwright test tests/experience-ui.spec.ts --workers=1",
    "test:customers": "playwright test tests/customers-ui.spec.ts --workers=1",
    "test:categories": "playwright test tests/categories-ui.spec.ts --workers=1",
    "qa:category-tree": "node scripts/category-tree-qa.mjs",
    "test:homepage": "playwright test tests/home-showcase.spec.ts tests/homepage-ui.spec.ts --workers=1",
    "test:ssr": "playwright test tests/ssr.spec.ts --workers=1",
    "test:performance": "playwright test tests/performance.spec.ts --workers=1",
    "test:catalog-api": "playwright test tests/catalog-api-ui.spec.ts --workers=1",
    "test:navigation": "playwright test tests/navigation-progress.spec.ts --workers=1",
    "test:connected": "node scripts/connected-api-qa.mjs",
    "test:operations": "node scripts/operations-ui-qa.mjs",
    "test:products": "node scripts/products-ui-qa.mjs",
    "test:admin-loading": "playwright test tests/admin-loading.spec.ts --workers=1",
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:menu": "node scripts/category-menu-qa.mjs",
    "test:cards": "node scripts/product-card-qa.mjs",
    "test:images": "node scripts/image-quality-qa.mjs",
    "test:admin": "node scripts/admin-qa.mjs",
    "test:warehouse": "node scripts/admin-warehouse-qa.mjs",
    "test:sales": "node scripts/admin-sales-qa.mjs",
    "test:approvals": "node scripts/admin-approval-qa.mjs",
    "test:accounting": "node scripts/admin-accounting-qa.mjs",
    "test:home-locks": "node scripts/home-lock-categories-qa.mjs",
    "test:detail": "node scripts/product-detail-qa.mjs",
    "test:ui": "node scripts/ui-qa.mjs",
    "qa:ui": "node scripts/ui-qa.mjs"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@bprogress/react": "^1.2.7",
    "@ckeditor/ckeditor5-react": "^12.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@splidejs/react-splide": "^0.7.12",
    "ckeditor5": "^49.0.0",
    "isomorphic-dompurify": "2.22.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "^9.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.14.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "exceljs": "^4.4.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3"
  }
}
