NEXT_PUBLIC_API_MODE=true
BACKEND_URL=http://127.0.0.1:4000
# Optional canonical public website origin. Otherwise inferred from hosting headers.
SITE_URL=

# Optional: same random secret as backend. Never prefix these with NEXT_PUBLIC_.
PROXY_CLIENT_IP_SECRET=
# Enable only a header overwritten/appended by your trusted hosting ingress.
PROXY_CLIENT_IP_HEADER=
PROXY_CLIENT_IP_FROM_RIGHT=1
